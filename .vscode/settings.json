{
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/CVS": true,
		"**/.DS_Store": true,
		"**/*.db": true,
		"**/data": true,
		"**/_data": true,
		"**/dist": true,
		"**/node_modules": true,
		"**/tmp": true
	},
	"[typescript][json][jsonc][markdown]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"json.schemas": [
		{ "fileMatch": ["postal-codes.config.json"], "url": "./config-schema.json" }
	],
	"coverage-gutters.coverageBaseDir": ".cov",
	"coverage-gutters.coverageFileNames": [
		"lcov.info",
		"cov.xml",
		"coverage.xml",
		"cobertura.xml",
		"jacoco.xml",
		"coverage.cobertura.xml"
	]
}
