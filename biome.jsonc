{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"assist": {
		"actions": {
			"source": {
				"useSortedPackageJson": "on",
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							[":BUN:", ":NODE:"],
							":BLANK_LINE:",
							[":PACKAGE:"],
							":BLANK_LINE:"
						]
					}
				}
			}
		}
	},
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	},
	"linter": {
		"rules": {
			"complexity": {
				"useSimplifiedLogicExpression": "error"
			},
			"correctness": {
				"noProcessGlobal": "on"
			},
			"performance": {
				"noAwaitInLoops": "error",
				"useTopLevelRegex": "error"
			},
			"suspicious": {
				"noShadow": "error"
			}
		},
		"domains": { "project": "none" }
	}
}
